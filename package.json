{
	"name": "@code-yeongyu/codex-lsp",
	"version": "0.1.0",
	"description": "Codex plugin that exposes Language Server Protocol tools and post-edit diagnostics.",
	"type": "module",
	"license": "MIT",
	"homepage": "https://github.com/code-yeongyu/codex-lsp",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/code-yeongyu/codex-lsp.git"
	},
	"bugs": {
		"url": "https://github.com/code-yeongyu/codex-lsp/issues"
	},
	"keywords": [
		"codex",
		"codex-plugin",
		"lsp",
		"language-server-protocol",
		"mcp",
		"diagnostics"
	],
	"bin": {
		"codex-lsp": "./dist/cli.js"
	},
	"files": [
		"dist",
		"hooks",
		"skills",
		".codex-plugin",
		".mcp.json",
		"LICENSE",
		"NOTICE",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "tsc --noEmit && biome check . && npm run build"
	},
	"dependencies": {
		"vscode-jsonrpc": "^8.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/node": "^25.7.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
